    <h2 id="painel-met-t">Como ler esta página</h2>
    <button id="painel-x" class="painel-x" aria-label="Fechar">×</button>
  </div>
  <p id="painel-nota" class="painel-nota" hidden></p>
  <div class="painel-c met"><div id="painel-grafico" class="pg" hidden></div>
    <div id="painel-corpo" class="pg-verbetes"></div></div>
</div>
