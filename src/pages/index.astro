---
// Entrega 2: o conteudo saiu do codigo. Os 17 verbetes e os 23 textos de
// grafico vem de src/content, validados por schema, e a pagina renderiza a
// partir dali. Nada de texto de interface escrito dentro do JavaScript.
import { getCollection } from 'astro:content';
import '../styles/global.css';

const idioma = 'pt';
const soIdioma = (e: { id: string }) => e.id.startsWith(idioma + '/');

const indicadores = (await getCollection('indicadores')).filter(soIdioma);
const graficos = (await getCollection('graficos')).filter(soIdioma);

// A ordem dos verbetes na pagina e a ordem em que os graficos aparecem, e nao
// alfabetica: quem le de cima para baixo encontra na mesma sequencia.
const ORDEM = ['tokens-por-semana','share-de-tokens','share-dos-5-maiores-e-hhi','origem-do-laboratorio',
  'licenca-dos-pesos','cobranca','faixa-de-preco-e-janela-de-contexto','gasto-estimado',
  'preco-efetivo-do-mercado','razao-dinheiro-sobre-volume','indice-de-inteligencia',
  'rotatividade-e-idade-do-top-10','tempo-ate-o-pico-e-meia-vida','a-forma-de-uma-temporada',
  'variacao-de-share-em-quatro-semanas','sinais-e-extrapolacao','a-linha-agregada-da-fonte'];
const chave = (e: { id: string }) => e.id.slice(idioma.length + 1);
const verbetes = indicadores.slice().sort(
  (a, b) => ORDEM.indexOf(chave(a)) - ORDEM.indexOf(chave(b)));

// Mapa entregue ao script como JSON, para o painel de metodologia montar o
// bloco de cada grafico sem nenhum texto escrito no codigo.
const conteudoGraficos = Object.fromEntries(graficos.map((g) => [g.data.id, {
  titulo: g.data.titulo,
  tipo: g.data.tipo,
  modos: g.data.modos,
  indicadores: g.data.indicadores,
  ler: g.data.comoLer,
  perg: g.data.perguntaQueResponde,
  nao: g.data.oQueNaoMostra,
}]));
